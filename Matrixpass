import re
import secrets
import string

try:
    import pyperclip
except ImportError:
    pyperclip = None


def check_password_strength(password):
    score = 0
    suggestions = []

    if len(password) >= 16:
        score += 3
    elif len(password) >= 12:
        score += 2
    elif len(password) >= 8:
        score += 1
    else:
        suggestions.append("किमान 8 characters वापरा.")

    if re.search(r"[a-z]", password):
        score += 1
    else:
        suggestions.append("Small letters वापरा.")

    if re.search(r"[A-Z]", password):
        score += 1
    else:
        suggestions.append("Capital letters वापरा.")

    if re.search(r"\d", password):
        score += 1
    else:
        suggestions.append("Numbers वापरा.")

    if re.search(r"[^A-Za-z0-9]", password):
        score += 2
    else:
        suggestions.append("Special characters वापरा.")

    if len(password) < 8 or score <= 2:
        strength = "कमकुवत"
    elif score <= 5:
        strength = "मध्यम"
    else:
        strength = "मजबूत"

    return strength, score, suggestions


def generate_password(length=16):
    length = max(length, 12)

    lowercase = string.ascii_lowercase
    uppercase = string.ascii_uppercase
    numbers = string.digits
    symbols = "!@#$%^&*()-_=+"

    characters = [
        secrets.choice(lowercase),
        secrets.choice(uppercase),
        secrets.choice(numbers),
        secrets.choice(symbols),
    ]

    all_characters = lowercase + uppercase + numbers + symbols

    characters.extend(
        secrets.choice(all_characters)
        for _ in range(length - 4)
    )

    secrets.SystemRandom().shuffle(characters)

    return "".join(characters)


def copy_to_clipboard(password):
    if pyperclip is None:
        print("\n❌ Copy सुविधा उपलब्ध नाही.")
        print("Install करा: pip install pyperclip")
        return

    try:
        pyperclip.copy(password)
        print("\n✅ Password Clipboard मध्ये Copy झाला.")
    except Exception:
        print("\n❌ Password Copy करता आला नाही.")


def analyze_password():
    print("\n" + "=" * 50)
    print("🔐 PASSWORD STRENGTH ANALYZER")
    print("=" * 50)

    password = input("Password टाका: ")

    strength, score, suggestions = check_password_strength(password)

    print("\n--- Result ---")
    print(f"Length   : {len(password)}")
    print(f"Score    : {score}/8")
    print(f"Strength : {strength}")

    if strength == "कमकुवत":
        print("🔴 Password कमकुवत आहे.")
    elif strength == "मध्यम":
        print("🟡 Password मध्यम आहे.")
    else:
        print("🟢 Password मजबूत आहे.")

    if suggestions:
        print("\nसुधारणेसाठी:")
        for suggestion in suggestions:
            print(f"• {suggestion}")


def password_generator():
    print("\n" + "=" * 50)
    print("🔑 SECURE PASSWORD GENERATOR")
    print("=" * 50)

    while True:
        try:
            length = int(input("Password length: "))
            break
        except ValueError:
            print("❌ कृपया योग्य number टाका.")

    password = generate_password(length)

    while True:
        print("\n" + "-" * 50)
        print(f"🔐 Generated Password: {password}")
        print("-" * 50)

        print("1. 📋 Copy")
        print("2. 🔄 Generate Again")
        print("3. ↩️ Main Menu")

        choice = input("\nपर्याय: ")

        if choice == "1":
            copy_to_clipboard(password)

        elif choice == "2":
            password = generate_password(length)

        elif choice == "3":
            break

        else:
            print("❌ चुकीचा पर्याय.")


def main():
    while True:
        print("\n" + "=" * 50)
        print("🛡️ CYBERSECURITY PASSWORD TOOL")
        print("=" * 50)

        print("1. 🔍 Password Strength Check")
        print("2. 🔑 Secure Password Generator")
        print("3. ❌ Exit")

        choice = input("\nपर्याय निवडा: ")

        if choice == "1":
            analyze_password()
        elif choice == "2":
            password_generator()
        elif choice == "3":
            print("\n👋 धन्यवाद!")
            break
        else:
            print("❌ चुकीचा पर्याय.")


if __name__ == "__main__":
    main()
